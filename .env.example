# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Path to your Google OAuth client secret JSON
# Download from Google Cloud Console > APIs & Services > Credentials
GSC_OAUTH_CLIENT_SECRETS_FILE=./client_secret.json

# Your GA4 property ID (numeric, found in GA4 Admin > Property Settings)
GA4_PROPERTY_ID=your_property_id_here

# DataForSEO API credentials
# Get your API password from dataforseo.com > Dashboard > API Access
DATAFORSEO_USERNAME=your@email.com
DATAFORSEO_PASSWORD=your_api_password_here
