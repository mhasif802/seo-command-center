{
  "mcpServers": {
    "google-analytics": {
      "command": "/path/to/analytics-mcp",
      "env": {
        "GA4_PROPERTY_ID": "YOUR_GA4_PROPERTY_ID"
      }
    },
    "google-search-console": {
      "command": "./mcp-gsc/venv/bin/python",
      "args": ["./mcp-gsc/gsc_server.py"],
      "env": {
        "GSC_OAUTH_CLIENT_SECRETS_FILE": "./client_secret.json",
        "GSC_DATA_STATE": "all"
      }
    },
    "dataforseo": {
      "command": "npx",
      "args": ["-y", "dataforseo-mcp-server"],
      "env": {
        "DATAFORSEO_USERNAME": "your@email.com",
        "DATAFORSEO_PASSWORD": "your_api_password_here"
      }
    }
  }
}
